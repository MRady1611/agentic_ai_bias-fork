#
# Make sure just one combination of ANTHROPIC_ENDPOINT, API_KEY and MODEL are uncommented!!!
#

#
# ARC models
#
ANTHROPIC_ENDPOINT=https://llm-api.arc.vt.edu/api/v1
ANTHROPIC_API_KEY=<your ARC api key>
ANTHROPIC_MODEL=vt-arc-llm
ANTHROPIC_MODEL=gp-oss-120b
ANTHROPIC_MODEL=glm-5.3

#
# ollama local (both ads1/ads2 have it installed with no API key required)
#
# use: ollama list     (to get local models)
ANTHROPIC_ENDPOINT=http://ads1.datasci.vt.edu:11434/v1/messages
# ANTHROPIC_ENDPOINT=http://ads2.datasci.vt.edu:11434/v1/messages
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=qwen3.8:27b
ANTHROPIC_MODEL=ornith-1.5:9b
ANTHROPIC_MODEL=granite4.2:8b
ANTHROPIC_MODEL=gemma4:12b

#
# anthropic model
#
ANTHROPIC_ENDPOINT=https://api.anthropic.com/
ANTHROPIC_API_KEY=<get this key from the instructor>
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_MODEL=claude-sonnet-5-5


OLLAMA_ENDPOINT=http://localhost:11434/v1
EMBED_MODEL=qwen3-embedding:8b

